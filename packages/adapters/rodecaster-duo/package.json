{
  "name": "@rode-control/adapter-rodecaster-duo",
  "version": "0.1.0",
  "description": "RØDECaster Duo device adapter (simulation for Phase 3 ownership validation)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "demo:mix-bank": "tsx src/demo-mix-bank.ts",
    "demo:midi": "tsx src/demo-midi.ts"
  },
  "dependencies": {
    "@rode-control/core": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
