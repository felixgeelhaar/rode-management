    "demo:vertical-slice": "tsx src/demo-vertical-slice.ts"
  },
  "dependencies": {
    "@rode-control/core": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
