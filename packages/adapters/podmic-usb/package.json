{
  "name": "@rode-control/adapter-podmic-usb",
  "version": "0.1.0",
  "description": "PodMic USB device adapter (simulation + protocol research stub)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
