{
  "name": "@rode-control/streamdeck-plugin",
  "version": "0.1.0",
  "description": "Stream Deck+ plugin client for the RØDE capability core",
  "type": "module",
  "scripts": {
    "build": "npm run build:bundle && npm run build:assets",
    "build:bundle": "esbuild src/plugin.ts --bundle --platform=node --format=cjs --outfile=com.felixgeelhaar.rode-control.sdPlugin/bin/plugin.js",
    "build:assets": "node ./scripts/ensure-placeholder-images.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "@rode-control/core": "0.1.0",
    "@rode-control/host": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.1",
    "typescript": "^5.8.2"
  }
}
