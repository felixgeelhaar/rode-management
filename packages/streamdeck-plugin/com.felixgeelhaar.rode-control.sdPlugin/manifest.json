{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.felixgeelhaar.rode-control",
  "Name": "R\u00d8DE Control",
  "Version": "1.0.0.0",
  "Author": "Felix Geelhaar",
  "Category": "R\u00d8DE Control",
  "CategoryIcon": "imgs/category-icon",
  "Icon": "imgs/plugin-icon",
  "Description": "Capability-driven Stream Deck+ controls for R\u00d8DE setups \u2014 dials, keys, workflows, live property inspector.",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.6"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "Actions": [
    {
      "UUID": "com.felixgeelhaar.rode-control.mic-gain",
      "Name": "Mic Gain",
      "Icon": "imgs/actions/mic-gain/icon",
      "Tooltip": "Adjust My Mic gain; press to mute (MIDI mode: mute-primary)",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust gain",
          "Push": "Toggle mute",
          "Touch": "Show ownership / focus readout"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/mic-gain/key",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.mic-monitor",
      "Name": "Mic Monitor",
      "Icon": "imgs/actions/mic-monitor/icon",
      "Tooltip": "Adjust PodMic USB monitor / headphone cue level",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust monitor level",
          "Push": "Toggle mic mute",
          "Touch": "Focus cue readout"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/mic-monitor/key",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.channel-level",
      "Name": "Channel Level",
      "Icon": "imgs/actions/channel-level/icon",
      "Tooltip": "Adjust a mix channel level (Game / Chat / Music)",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Rotate": "Adjust level",
          "Push": "Toggle mute",
          "Touch": "Show channel ownership / focus"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/channel-level/key",
          "TitleAlignment": "middle",
          "FontSize": 12
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.mute-toggle",
      "Name": "Mute Toggle",
      "Icon": "imgs/actions/mute-toggle/icon",
      "Tooltip": "Toggle mute on a channel (works with simulators and official R\u00d8DECaster MIDI)",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/mute-toggle/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "MUTE"
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.listen-toggle",
      "Name": "Listen Toggle",
      "Icon": "imgs/actions/listen-toggle/icon",
      "Tooltip": "Toggle Listen/solo on a R\u00d8DECaster channel (official MIDI Tier B)",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/listen-toggle/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "LISTEN"
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.hpf-toggle",
      "Name": "High-Pass",
      "Icon": "imgs/actions/hpf-toggle/icon",
      "Tooltip": "Toggle mic high-pass filter (PodMic sim / when hardware exposes it)",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/hpf-toggle/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "HPF"
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.compressor-toggle",
      "Name": "Compressor",
      "Icon": "imgs/actions/compressor-toggle/icon",
      "Tooltip": "Toggle mic compressor (PodMic sim / when hardware exposes it)",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/compressor-toggle/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "COMP"
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.pad-trigger",
      "Name": "SMART Pad",
      "Icon": "imgs/actions/pad-trigger/icon",
      "Tooltip": "Trigger a R\u00d8DECaster SMART Pad (official MIDI Tier B)",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/pad-trigger/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "PAD"
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.record-toggle",
      "Name": "Record",
      "Icon": "imgs/actions/record-toggle/icon",
      "Tooltip": "Start/stop R\u00d8DECaster recording (official MIDI Tier B)",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/record-toggle/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "REC"
        }
      ],
      "PropertyInspectorPath": "ui/property-inspector.html"
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.apply-workflow",
      "Name": "Apply Workflow",
      "Icon": "imgs/actions/apply-workflow/icon",
      "Tooltip": "Apply a product workflow preset (Streaming / Podcast)",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/actions/apply-workflow/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "STREAM"
        }
      ]
    },
    {
      "UUID": "com.felixgeelhaar.rode-control.capture-workflow",
      "Name": "Capture Workflow",
      "Icon": "imgs/actions/capture-workflow/icon",
      "Tooltip": "Snapshot the live mix into a workflow preset id",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/property-inspector.html",
      "States": [
        {
          "Image": "imgs/actions/capture-workflow/key",
          "TitleAlignment": "middle",
          "FontSize": 12,
          "Title": "CAPTURE"
        }
      ]
    }
  ]
}
