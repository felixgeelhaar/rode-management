{
  "name": "@rode-control/cli",
  "version": "0.1.0",
  "description": "CLI client for the RØDE capability core (second surface after Stream Deck)",
  "type": "module",
  "bin": {
    "rode-control": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/cli.ts"
  },
  "dependencies": {
    "@rode-control/core": "0.1.0",
    "@rode-control/host": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
